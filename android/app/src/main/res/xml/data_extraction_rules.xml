<?xml version="1.0" encoding="utf-8"?>
<!-- Keep search coordinates out of both cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sportspot.db" />
        <exclude domain="database" path="sportspot.db-journal" />
        <exclude domain="database" path="sportspot.db-shm" />
        <exclude domain="database" path="sportspot.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sportspot.db" />
        <exclude domain="database" path="sportspot.db-journal" />
        <exclude domain="database" path="sportspot.db-shm" />
        <exclude domain="database" path="sportspot.db-wal" />
    </device-transfer>
</data-extraction-rules>
