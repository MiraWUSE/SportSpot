  "item": [
    {
      "name": "GET - Search Sports Spots",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\npm.test(\"Статус ответа 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Ответ содержит массив площадок\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.spots).to.be.an(\"array\");\n});\n\npm.test(\"Количество площадок совпадает\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.count).to.eql(data.spots.length);\n});\n\npm.test(\"Источник данных - Overpass API\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.source).to.eql(\"Overpass API\");\n});\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://tnqkaamvvxwsimfydurg.supabase.co/functions/v1/search-sports-spots-v1?lat=56.3269&lon=44.0059&radius=1000&sport=all",
